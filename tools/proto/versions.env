# Generator versions for the checked-in protobuf stubs. tools/proto/generate.sh
# and the proto-stubs CI job read this file, so both use the same versions.
# The Python stubs use grpcio-tools from clients/python/uv.lock instead.
PROTOC_VERSION=36.2
PROTOC_GEN_GO_VERSION=1.36.12
PROTOC_GEN_GO_GRPC_VERSION=1.6.2
